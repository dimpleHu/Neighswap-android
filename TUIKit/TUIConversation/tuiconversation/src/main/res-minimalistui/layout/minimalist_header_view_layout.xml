<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="?attr/actionBarSize"
    xmlns:tools="http://schemas.android.com/tools"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@color/teal_700"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:elevation="4dp">

    <!-- 返回按钮（默认隐藏，需要时显示） -->
    <ImageView
        android:id="@+id/home_rtcube"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="?attr/core_title_bar_back_icon"
        android:tint="@color/white"
        android:visibility="gone"
        tools:visibility="visible"
        tools:src="@android:drawable/ic_menu_revert"
        android:clickable="true"
        android:focusable="true"
        android:padding="8dp" />

    <!-- 标题 -->
    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/conversation_minimalist_chat"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center_vertical"
        android:paddingStart="8dp" />

    <!-- 编辑按钮 -->
    <TextView
        android:id="@+id/edit_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:text="@string/conversation_title_edit"
        android:textSize="16sp"
        android:padding="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginEnd="8dp" />

    <!-- 创建新对话按钮（隐藏） -->
    <ImageView
        android:id="@+id/create_new_button"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <!-- 完成编辑按钮 -->
    <TextView
        android:id="@+id/edit_done"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/conversation_minimalist_done"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:padding="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        tools:visibility="visible"/>

    <!-- 备用标题（隐藏） -->
    <TextView
        android:id="@+id/title_rtcube"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:text="@string/conversation_minimalist_chat"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold" />
</LinearLayout>