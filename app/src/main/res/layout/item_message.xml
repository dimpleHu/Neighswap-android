<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="5dp">

    <!-- 消息气泡容器 -->
    <LinearLayout
        android:id="@+id/ll_message_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- 左侧头像（接收消息时显示） -->
        <ImageView
            android:id="@+id/iv_message_avatar_left"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_avatar"
            android:scaleType="centerCrop"
            android:layout_marginEnd="8dp"
            android:visibility="gone"/>

        <!-- 左侧空白（用于右对齐） -->
        <View
            android:id="@+id/view_left_space"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <!-- 消息气泡 -->
        <LinearLayout
            android:id="@+id/ll_message_bubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/shape_message_bubble_sent"
            android:padding="12dp"
            android:maxWidth="250dp">

            <TextView
                android:id="@+id/tv_message_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="消息内容"
                android:textSize="16sp"
                android:textColor="@color/white"/>

            <TextView
                android:id="@+id/tv_message_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12:00"
                android:textSize="10sp"
                android:textColor="@color/white"
                android:layout_gravity="end"
                android:layout_marginTop="5dp"/>

        </LinearLayout>

        <!-- 右侧空白（用于左对齐） -->
        <View
            android:id="@+id/view_right_space"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <!-- 右侧头像（发送消息时显示） -->
        <ImageView
            android:id="@+id/iv_message_avatar_right"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_avatar"
            android:scaleType="centerCrop"
            android:layout_marginStart="8dp"
            android:visibility="gone"/>

    </LinearLayout>

</LinearLayout>

