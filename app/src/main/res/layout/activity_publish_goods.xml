<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <!-- 新增：顶部Toolbar（返回按钮） -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_publish"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/teal_700"
        app:title="发布物品"
        app:navigationIcon="@drawable/ic_back"
        app:titleTextColor="@color/white"/>

    <!-- 原有内容：ScrollView包裹表单 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- 新增：图片上传区域（最多9张） -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="上传图片（最多9张）"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"/>

            <GridView
                android:id="@+id/gv_pic_upload"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:numColumns="3"
                android:horizontalSpacing="10dp"
                android:verticalSpacing="10dp"
                android:layout_marginBottom="20dp"/>

            <!-- 原有：物品名称、分类等表单 -->
            <EditText
                android:id="@+id/et_goods_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="请输入物品名称"
                android:padding="15dp"
                android:background="@drawable/shape_edittext"
                android:layout_marginBottom="15dp"/>

            <Spinner
                android:id="@+id/sp_category"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/shape_edittext"
                android:padding="15dp"
                android:entries="@array/category_array"
                android:layout_marginBottom="15dp"/>

            <EditText
                android:id="@+id/et_goods_price"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="请输入物品价格（元）"
                android:inputType="numberDecimal"
                android:padding="15dp"
                android:background="@drawable/shape_edittext"
                android:layout_marginBottom="15dp"/>

            <!-- 商品描述区域 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="20dp">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">
                    
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="商品描述"
                        android:textSize="16sp"
                        android:textStyle="bold"/>
                    
                    <Button
                        android:id="@+id/btn_ai_polish"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AI润色"
                        android:textSize="12sp"
                        android:background="@color/teal_700"
                        android:textColor="@color/white"
                        android:paddingLeft="15dp"
                        android:paddingRight="15dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"/>
                </LinearLayout>
                
                <EditText
                    android:id="@+id/et_goods_desc"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:hint="请输入物品描述（可点击AI润色按钮进行智能润色）"
                    android:gravity="top"
                    android:padding="15dp"
                    android:background="@drawable/shape_edittext"/>
            </LinearLayout>

            <!-- 位置显示与刷新 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="15dp">

                <TextView
                    android:id="@+id/tv_location"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="定位中..."
                    android:textColor="@color/grey"
                    android:textSize="14sp"/>

                <Button
                    android:id="@+id/btn_refresh_location"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="获取定位"
                    android:textSize="12sp"
                    android:background="@color/teal_700"
                    android:textColor="@color/white"/>
            </LinearLayout>

            <!-- 发布按钮 -->
            <Button
                android:id="@+id/btn_publish"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="发布物品"
                android:background="@color/teal_700"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:padding="15dp"/>

        </LinearLayout>
    </ScrollView>

</LinearLayout>